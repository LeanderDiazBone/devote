--alg=Observer
--script=train_eval
--debug=0
--project_name=devote_paper
--entity=
--model_size=size6m
--ac_inputs=obs
--use_image=0
--log_images=0
--log_coverage=1
--log_coverage_heatmap=0
--num_envs=16
--num_envs_eval=4
--train_ratio=1
--batch_size=32
--batch_length=64
--batch_length_eval=64
--replay_context=0
--contdisc=0
--discount=0.99
--actor_layers=3
--actor_units=192
--critic_layers=3
--critic_units=192
--critic_dist=symexp_twohot
--residual_bootstrap_dist=mse
--actor_dist_cont=squashed_normal
--target_mode=individual
--pessimism=-1
--use_entropy_backup_sac=0
--init_alpha=1
--target_entropy_scale_cont=1
--actor_lr=0.0003
--critic_lr=0.0003
--critic_wd=0.01
--actor_wd=0
--slow_critic_fraction=0.005
--boot_prob=0.5
--beta=1
--beta_learn=0
--normalize_exp_mean=1
--pc_target_actor=exp_actor
--td_target_actor=actor
--prior_action_independent=1
--prior_corrector=1
--prior_use_rff=1
--prior_layers=1
--prior_units=1024
--prior_act=-
--prior_outact=tanh
--prior_epistemic=0
--prior_epistemic_samples=1
--value_prior_scale=1
--reward_prior_scale=0
--td_lambda=0
--residual_transform=0
--reset_every=250000
--reset_keys=agent/(q[^/]*/residual_bootstrap|exp_actor[^/]*)/
--reset_mode=soft
--reset_soft_alpha=0.5
--save_every=-1
--group_name=paper_candidate
