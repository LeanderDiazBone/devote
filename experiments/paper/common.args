--alg=Observer
--script=train_eval
--debug=0
--project_name=devote_paper
--model_size=size6m
--ac_inputs=obs
--use_image=0
--log_images=1
--log_coverage=1
--log_coverage_heatmap=1
--explore_trajectory_dir=0
--num_envs=32
--num_envs_eval=32
--train_ratio=256
--eval_every=500
--train_rollout_steps=25
--big_report_every=1
--batch_size=32
--batch_length=65
--batch_length_eval=65
--replay_context=0
--contdisc=0
--discount=-1
--actor_layers=3
--actor_units=1024
--critic_layers=3
--critic_units=1024
--critic_dist=mse
--residual_bootstrap_dist=mse
--actor_dist_cont=squashed_normal
--target_mode=individual
--pessimism=-1
--use_entropy_backup_sac=0
--init_alpha=1
--target_entropy_scale_cont=0.5
--actor_lr=0.0003
--critic_lr=0.0003
--critic_wd=0.01
--actor_wd=0
--slow_critic_fraction=0.01
--boot_prob=0.5
--beta=1
--beta_learn=0
--normalize_exp_mean=0
--pc_target_actor=exp_actor
--td_target_actor=actor
--prior_action_independent=1
--prior_corrector=1
--prior_use_rff=1
--prior_layers=1
--prior_units=1024
--prior_act=-
--prior_outact=tanh
--prior_epistemic=0
--prior_epistemic_dim=0
--prior_epistemic_samples=1
--value_prior_scale=1
--reward_prior_scale=0
--td_lambda=0
--residual_transform=0
--reset_every=50000
--reset_max_step=100000000
--reset_keys=agent/(q[^/]*/residual_bootstrap|intr_q[^/]*/(head|residual_bootstrap)|exp_actor[^/]*)/
--reset_mode=soft
--reset_soft_alpha=0.5
--cand_policy=epsilon_greedy
--save_every=10000
--group_name=paper_candidate
